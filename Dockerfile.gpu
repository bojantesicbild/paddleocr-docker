# syntax=docker/dockerfile:1.6
# GPU variant — Docling backend (torch). Build with:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml build
# linux/amd64 only.

# -------- Stage 1: build wheels --------
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04 AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_ROOT_USER_ACTION=ignore \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-dev \
        python3-pip \
        build-essential \
        ca-certificates \
        curl \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY requirements.txt .
# torch CUDA wheels from PyTorch's own index. cu126 wheels are compatible
# with our CUDA 12.6.3 runtime base.
RUN pip wheel --wheel-dir=/wheels \
        --extra-index-url https://download.pytorch.org/whl/cu126 \
        torch torchvision \
        -r requirements.txt


# -------- Stage 2: runtime --------
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04 AS runtime

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp \
    OCR_LANGUAGE=ch \
    OMP_NUM_THREADS=4 \
    HF_HOME=/tmp/.cache/huggingface \
    TORCHDYNAMO_DISABLE=1 \
    DEBIAN_FRONTEND=noninteractive
# Note: DOCLING_ARTIFACTS_PATH intentionally NOT set. With it set,
# docling treats that path as authoritative — if a model isn't pre-baked
# there it raises "model not found in artifacts_path" instead of falling
# back to HuggingFace auto-download. Unset lets docling pull models on
# first use into HF_HOME (which is persisted via the volume mount).
#
# TORCHDYNAMO_DISABLE=1: docling's picture classifier triggers torch.compile
# (inductor → triton → needs a C compiler at runtime). The runtime image
# is built off cuda-runtime which ships no gcc, so compilation crashes
# with "Failed to find C compiler" the first time the classifier sees a
# chart. Disabling dynamo makes the model run eager-mode (slightly slower
# but reliable). Alternative would be installing build-essential, ~70 MB.

# Optional API key baked at build time (passed via --build-arg from CI secret).
ARG OCR_API_KEY=""
ENV OCR_API_KEY=${OCR_API_KEY}

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 \
        python3-pip \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        curl \
        redis-server \
        supervisor \
        poppler-utils \
        tesseract-ocr \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv

COPY --from=builder /wheels /wheels
COPY requirements.txt .
RUN pip install --no-index --find-links=/wheels torch torchvision -r requirements.txt \
    && rm -rf /wheels \
    && find /usr/local/lib /usr/lib/python3.12 -type d -name '__pycache__' -prune -exec rm -rf {} + 2>/dev/null || true \
    && find /usr/local/lib /usr/lib/python3.12 -type d -name 'tests' -path '*/site-packages/*' -prune -exec rm -rf {} + 2>/dev/null || true \
    && find /usr/local/lib /usr/lib/python3.12 -type f -name '*.pyc' -delete 2>/dev/null || true \
    && rm -rf /root/.cache /tmp/pip-*

COPY ocr_settings.json supervisord.conf ./
COPY app ./app

# Pre-download Docling models so first request doesn't pay the ~30-60s
# download cost. Total ~600-800 MB (layout + table + picture-classifier).
ARG PRECACHE_MODELS=0
RUN mkdir -p /tmp/.docling /tmp/.cache/huggingface && \
    chmod -R 0777 /tmp/.docling /tmp/.cache /tmp && \
    if [ "$PRECACHE_MODELS" = "1" ]; then \
      python -c "from docling.utils.model_downloader import download_models; download_models(); print('docling models cached')" \
        || echo "WARN: precache failed; first boot will download models"; \
    else echo "skipping model pre-cache (PRECACHE_MODELS=0)"; fi && \
    chmod -R 0777 /tmp/.docling /tmp/.cache /tmp

# Make app dirs writable for non-root runtime users (OVH AI uses UID 42420).
RUN chmod -R 0777 /srv /var/log /var/lib/redis /var/run || true

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=10 \
    CMD curl -fsS http://localhost:8080/health || exit 1

CMD ["supervisord", "-n", "-c", "/srv/supervisord.conf"]
